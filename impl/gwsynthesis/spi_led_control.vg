    .I(spi_csn) 
);
  IBUF spi_mosi_ibuf (
    .O(spi_mosi_d),
    .I(spi_mosi) 
);
  OBUF spi_miso_obuf (
    .O(spi_miso),
    .I(spi_miso_d) 
);
