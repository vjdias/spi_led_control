wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  IBUF spi_sclk_ibuf (
    .O(spi_sclk_d),
    .I(spi_sclk) 
);
  IBUF spi_csn_ibuf (
