module top_led_spi (
  clk,
  rst_n,
  spi_sclk,
  spi_csn,
  spi_mosi,
  spi_miso,
  leds
)
;
input clk;
input rst_n;
input spi_sclk;
input spi_csn;
input spi_mosi;
output spi_miso;
output [4:0] leds;
wire clk_d;
wire rst_n_d;
wire spi_sclk_d;
wire spi_csn_d;
wire spi_mosi_d;
wire spi_miso_d;
