wire [2:0] \led_if.req.led_idx ;
wire [2:0] st_13;
wire [7:0] req_cmd_code_Z;
wire [3:0] st_14;
wire [7:0] tx_byte;
wire [2:0] st_15;
wire [4:0] leds_d;
wire [7:0] \led_if.rsp.id ;
wire [2:0] \led_if.rsp.led_idx ;
wire [1:0] st_16;
