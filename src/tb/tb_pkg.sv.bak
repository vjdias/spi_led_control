`timescale 1ns/1ps
`ifndef TB_PKG_SV
`define TB_PKG_SV

package tb_pkg;

  // Tipos e constantes
  typedef byte byte_t;

  localparam byte_t HDR_REQ  = 8'hAA;
  localparam byte_t TAIL_REQ = 8'h55;
  localparam byte_t HDR_RSP  = 8'hAB;
  localparam byte_t TAIL_RSP = 8'h54;
  localparam byte_t CMD_LED  = 8'h30;

  // -------------------------- Transacao LED --------------------------
  class led_cmd_item;
    rand byte_t id;
    rand byte_t idx;
    rand bit    val;
    bit         exp_ok;

    function new(byte_t id = 8'h01, byte_t idx = 0, bit val = 1);
      this.id  = id;
      this.idx = idx & 8'h07;
      this.val = val & 1'b1;
      this.exp_ok = (idx < 8);
    endfunction

    function void build_req_bytes(ref byte req[$]);
      req.delete();
      req.push_back(HDR_REQ);
      req.push_back(CMD_LED);
      req.push_back(byte'(id));
      req.push_back(byte'(idx));
      req.push_back(byte'({7'b0, val}));
      req.push_back(TAIL_REQ);
    endfunction

    function void build_exp_rsp_body(ref byte body[$]);
      body.delete();
      body.push_back(CMD_LED);
      body.push_back(byte'(id));
      body.push_back(byte'(idx & 8'h07));
      body.push_back(byte'({7'b0, val[0]}));
      body.push_back(byte'({7'b0, exp_ok[0]}));
    endfunction
  endclass : led_cmd_item

  // ------------------------ BFM SPI Master --------------------------
  // Requer que spi_if.sv tenha sido compilado antes.
  class spi_master_bfm;
    virtual spi_if.master vif;

    function new(virtual spi_if.master vif);
      this.vif = vif;
    endfunction

    task automatic init();
      vif.init_bus();
    endtask

    task automatic send_led_req(led_cmd_item tr);
      byte req[$];
      tr.build_req_bytes(req);
      vif.cs_low();
      vif.write_bytes(req);
      vif.cs_high();
    endtask

    task automatic read_led_rsp(output byte rsp[$], input int max_poll = 32);
      byte first;
      bit  found;
      byte body[$];

      rsp.delete();
      vif.cs_low();
      vif.poll_for_header(HDR_RSP, max_poll, found, first);
      if (!found) begin
        $error("[SPI BFM] Timeout esperando HDR_RSP (0x%02h).", HDR_RSP);
        vif.cs_high();
        return;
      end
      vif.read_n_bytes(6, body);
      vif.cs_high();

      rsp.push_back(first); // HDR_RSP
      foreach (body[i]) rsp.push_back(body[i]);
    endtask
  endclass : spi_master_bfm

  // --------------------------- Scoreboard ---------------------------
  class led_scoreboard;
    virtual leds_if.mon v_leds;
    mailbox exp_mb;
    mailbox got_mb;

    function new(virtual leds_if.mon v_leds);
      this.v_leds = v_leds;
      this.exp_mb = new();
      this.got_mb = new();
    endfunction

    task automatic check_one(led_cmd_item tr, byte rsp[$]);
      if (rsp.size() != 7) begin
        $error("[SCB] Resposta tamanho invalido: %0d", rsp.size());
        return;
      end
      if (rsp[0] != HDR_RSP) $error("[SCB] HDR invalido: 0x%02h", rsp[0]);
      if (rsp[1] != CMD_LED) $error("[SCB] CMD invalido: 0x%02h", rsp[1]);
      if (rsp[2] != tr.id)   $error("[SCB] ID invalido: 0x%02h (exp=0x%02h)", rsp[2], tr.id);
      if ((rsp[3] & 8'h07) != (tr.idx & 8'h07))
        $error("[SCB] IDX invalido: 0x%02h (exp=0x%02h)", rsp[3], tr.idx & 8'h07);
      if ((rsp[4] & 8'h01) != (tr.val & 1))
        $error("[SCB] VAL invalido: 0x%02h (exp=%0d)", rsp[4], tr.val);
      if ((rsp[5] & 8'h01) != (tr.exp_ok & 1))
        $error("[SCB] OK invalido: 0x%02h (exp=%0d)", rsp[5], tr.exp_ok);
      if (rsp[6] != TAIL_RSP) $error("[SCB] TAIL invalido: 0x%02h", rsp[6]);

      // aguarda propagacao simples
      #40ns;
      bit led_hw;
      led_hw = v_leds.leds[tr.idx];
      if (led_hw != tr.val)
        $error("[SCB] LED[%0d] HW=%0d difere do esperado %0d", tr.idx, led_hw, tr.val);
      else
        $display("[SCB] OK: LED[%0d]=%0d, ID=0x%02h.", tr.idx, tr.val, tr.id);
    endtask

    task automatic run();
      led_cmd_item tr;
      byte rsp[$];
      forever begin
        exp_mb.get(tr);
        got_mb.get(rsp);
        check_one(tr, rsp);
      end
    endtask
  endclass : led_scoreboard

  // ----------------------------- Env -------------------------------
  class led_env;
    spi_master_bfm bfm;
    led_scoreboard scb;

    function new(virtual spi_if.master vif, virtual leds_if.mon v_leds);
      bfm = new(vif);
      scb = new(v_leds);
    endfunction

    task automatic build();
      bfm.init();
      fork
        begin
          scb.run(); // << ponto-e-virgula garantido
        end
      join_none
    endtask

    task automatic do_led(led_cmd_item tr);
      byte rsp[$];
      scb.exp_mb.put(tr);
      bfm.send_led_req(tr);
      bfm.read_led_rsp(rsp);
      scb.got_mb.put(rsp);
    endtask
  endclass : led_env

  // ----------------------------- Test ------------------------------
  class led_test;
    led_env env;
    function new(led_env env); this.env = env; endfunction

    task automatic run();
      env.build();

      led_cmd_item t0 = new(8'hA1, 0, 1); env.do_led(t0);
      led_cmd_item t1 = new(8'hA2, 3, 1); env.do_led(t1);
      led_cmd_item t2 = new(8'hA3, 3, 0); env.do_led(t2);
      led_cmd_item t3 = new(8'hA4, 4, 1); env.do_led(t3);
      led_cmd_item t4 = new(8'hA5, 8, 1); env.do_led(t4); // idx 8 -> mascara p/0

      #2us;
      $display("[TEST] Finalizado.");
      $finish;
    endtask
  endclass : led_test

endpackage
`endif
