`pragma protect end_protected
module SPI_MASTER_Top (
  I_CLK,
  I_RESETN,
  I_TX_EN,
  I_WADDR,
  I_WDATA,
  I_RX_EN,
  I_RADDR,
  O_RDATA,
  O_SPI_INT,
  MISO_MASTER,
  MOSI_MASTER,
  SS_N_MASTER,
  SCLK_MASTER,
  MISO_SLAVE,
  MOSI_SLAVE,
  SS_N_SLAVE,
  SCLK_SLAVE
)
;
input I_CLK;
input I_RESETN;
input I_TX_EN;
input [2:0] I_WADDR;
input [7:0] I_WDATA;
input I_RX_EN;
input [2:0] I_RADDR;
output [7:0] O_RDATA;
output O_SPI_INT;
input MISO_MASTER;
output MOSI_MASTER;
output [0:0] SS_N_MASTER;
output SCLK_MASTER;
output MISO_SLAVE;
input MOSI_SLAVE;
input SS_N_SLAVE;
input SCLK_SLAVE;
wire VCC;
wire GND;
  \~spi_master.SPI_MASTER_Top  u_spi_master (
    .I_CLK(I_CLK),
    .I_RX_EN(I_RX_EN),
    .SCLK_SLAVE(SCLK_SLAVE),
    .MOSI_SLAVE(MOSI_SLAVE),
    .I_TX_EN(I_TX_EN),
    .I_RESETN(I_RESETN),
    .SS_N_SLAVE(SS_N_SLAVE),
    .I_WDATA(I_WDATA[7:0]),
    .I_RADDR(I_RADDR[2:0]),
    .I_WADDR(I_WADDR[2:0]),
    .MISO_SLAVE(MISO_SLAVE),
    .O_SPI_INT(O_SPI_INT),
    .O_RDATA(O_RDATA[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* SPI_MASTER_Top */
